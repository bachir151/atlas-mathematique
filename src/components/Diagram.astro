---
interface Props { type?: 'square' | 'orbit' | 'wave'; /** Distinguishes the grid pattern when several diagrams of one type are on a page. */ uid?: string }
const { type = 'square', uid } = Astro.props;
const gridId = uid ? `grid-${type}-${uid}` : `grid-${type}`;
---
<svg viewBox="0 0 300 200" fill="none" aria-hidden="true" class="course-diagram">
  <defs><pattern id={gridId} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="currentColor" opacity=".16" /></pattern></defs>
  <rect width="300" height="200" fill={`url(#${gridId})`} />
  {type === 'square' && <><rect x="105" y="55" width="90" height="90" rx="1" stroke="currentColor" opacity=".22" /><rect x="105" y="55" width="90" height="90" rx="1" stroke="currentColor" stroke-width="1.5" transform="rotate(-25 150 100)" /><circle cx="128.2" cy="40.2" r="4" fill="currentColor" /><circle cx="150" cy="100" r="3" fill="currentColor" /><path d="M219 111a70 70 0 0 0-42-76m0 0 4 10m-4-10 11-1" stroke="currentColor" stroke-width="1.3" /></>}
  {type === 'orbit' && <><ellipse cx="150" cy="100" rx="78" ry="30" stroke="currentColor" transform="rotate(-35 150 100)" /><ellipse cx="150" cy="100" rx="78" ry="30" stroke="currentColor" transform="rotate(35 150 100)" opacity=".5" /><ellipse cx="150" cy="100" rx="78" ry="30" stroke="currentColor" transform="rotate(90 150 100)" opacity=".3" /><circle cx="150" cy="100" r="5" fill="currentColor" /></>}
  {type === 'wave' && <><path d="M40 100h220M150 30v140" stroke="currentColor" opacity=".2" /><path d="M40 140c40 0 25-90 65-90s40 100 80 100 30-90 75-90" stroke="currentColor" stroke-width="1.8" /><path d="M40 155c40 0 25-90 65-90s40 100 80 100 30-90 75-90" stroke="currentColor" opacity=".2" /></>}
</svg>

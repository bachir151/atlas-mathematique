---
/**
 * Interactive figure of the lesson « Anneaux quotients & morphismes »: classes
 * modulo n (n from 2 to 8), remainders of two integers a and b, classes of
 * a + b and a b, computations before reduction and the full tables of sums
 * and products of classes. The drawing, its text reading and the tables are
 * rendered at build time; src/scripts/rquot-figures.ts makes the controls
 * live. Usage in MDX: <RingQuotientFigure number="1" />
 */
import { FIELDS, LIMITS, RQUOT_PRESET, rquotReading, rquotText, type RQuotField } from '../../figures/rquot';
import { rquotSvg, HEIGHT, WIDTH } from '../../figures/rquot-svg';
import '../../styles/figures.css';
import '../../styles/figures-rquot.css';

interface Props { number?: string }
const { number } = Astro.props;
const id = 'figure-anneau-quotient';
const state = { ...RQUOT_PRESET };
const reading = rquotReading(state);
const text = rquotText(reading);
const labels: Record<RQuotField, string> = { n: 'Modulo n (de 2 à 8)', a: 'Représentant a (de −20 à 20)', b: 'Représentant b (de −20 à 20)' };
const actions: [string, string][] = [
  ['a-up', `a + ${state.n}`], ['a-down', `a − ${state.n}`], ['b-up', `b + ${state.n}`], ['b-down', `b − ${state.n}`],
];
const tables = [
  { key: 'add', table: text.add }, { key: 'mul', table: text.mul },
];
---
<figure class="plane-figure series-figure rquot-figure" id={id} data-rquot-figure aria-labelledby={`${id}-title`}>
  <figcaption class="plane-figure-caption">
    <span class="eyebrow">Figure{number && ` ${number}`} · interactive</span>
    <span class="plane-figure-title" id={`${id}-title`}>Classes modulo n : somme et produit des restes</span>
  </figcaption>
  <div class="plane-figure-layout">
    <div class="plane-figure-stage">
      <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-labelledby={`${id}-title ${id}-status`} data-rquot-svg set:html={rquotSvg(reading)} />
      <p class="plane-figure-hint">
        Les n classes sont dessinées en boîtes ; celles de a, de b, de a + b et de ab sont repérées, les classes des résultats en orange. Changer un représentant de n conserve sa classe, donc les deux classes de résultat.
      </p>
    </div>
    <div class="plane-figure-side">
      <div class="plane-controls" role="group" aria-label="Modulo et représentants">
        {FIELDS.map(name => (
          <label class="plane-field">
            <span>{labels[name]}</span>
            <input type="number" inputmode="numeric" step="1" min={LIMITS[name][0]} max={LIMITS[name][1]} value={state[name]} data-rquot-param={name} disabled />
          </label>
        ))}
      </div>
      <div class="plane-actions">
        {actions.map(([action, label]) => (
          <button type="button" class="button secondary" data-rquot-action={action} disabled>{label}</button>
        ))}
        <button type="button" class="button primary" data-rquot-action="reset" disabled>Remettre les valeurs initiales</button>
      </div>
      <dl class="plane-reading" data-rquot-rows>
        {text.rows.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
      </dl>
      <p class="plane-status" id={`${id}-status`} role="status" aria-live="polite" data-rquot-status>{text.status}</p>
    </div>
  </div>
  <div class="rquot-tables">
    {tables.map(({ key, table }) => (
      <div>
        <p class="series-table-caption" id={`${id}-${key}-caption`} data-rquot-caption={key}>{table.caption}</p>
        <div class="table-scroll series-table rquot-table" tabindex="0" role="region" aria-labelledby={`${id}-${key}-caption`}>
          <table aria-labelledby={`${id}-${key}-caption`}>
            <thead data-rquot-head={key}><tr><th scope="col">{table.corner}</th>{table.head.map(label => <th scope="col">{label}</th>)}</tr></thead>
            <tbody data-rquot-table={key}>
              {table.body.map(({ header, cells }, i) => (
                <tr><th scope="row">{header}</th>{cells.map((cell, j) => <td aria-current={i === table.current.row && j === table.current.col ? 'true' : undefined}>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>
  <p class="technical-note">Les calculs sont exacts (entiers). La figure illustre un cas, avec des valeurs bornées : elle ne démontre rien et ne remplace pas les démonstrations de la leçon.</p>
  <noscript><p class="technical-note">Activez JavaScript pour modifier la figure. La figure, ses valeurs initiales et les deux tables restent lisibles.</p></noscript>
</figure>
<script>
  import { initRingQuotientFigure } from '../../scripts/rquot-figures';
  document.querySelectorAll<HTMLElement>('[data-rquot-figure]').forEach(initRingQuotientFigure);
</script>

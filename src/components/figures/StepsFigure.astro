---
/**
 * Interactive figure of the lesson « Sous-groupes & multiples entiers »:
 * positions m·a + n·b on a graduated line. The line, its text reading and the
 * table of listed positions are rendered at build time;
 * src/scripts/steps-figures.ts makes the controls live.
 * Usage in MDX: <StepsFigure number="1" />
 */
import { COEFFICIENT_MAX, FIELDS, LIMITS, STEPS_PRESET, stepsReading, stepsText, type StepsField } from '../../figures/steps';
import { stepsSvg, HEIGHT, WIDTH } from '../../figures/steps-svg';
import '../../styles/figures.css';

interface Props { number?: string }
const { number } = Astro.props;
const id = 'figure-pas-entiers';
const state = { ...STEPS_PRESET };
const reading = stepsReading(state);
const text = stepsText(state, reading);
const labels: Record<StepsField, string> = { a: 'Pas a', b: 'Pas b', m: 'Coefficient m', n: 'Coefficient n' };
const coefficientActions: [string, string][] = [
  ['m-up', 'm + 1'], ['m-down', 'm − 1'], ['n-up', 'n + 1'], ['n-down', 'n − 1'],
];
---
<figure class="plane-figure series-figure steps-figure" id={id} data-steps-figure aria-labelledby={`${id}-title`}>
  <figcaption class="plane-figure-caption">
    <span class="eyebrow">Figure{number && ` ${number}`} · interactive</span>
    <span class="plane-figure-title" id={`${id}-title`}>Combiner deux pas entiers</span>
  </figcaption>
  <div class="plane-figure-layout">
    <div class="plane-figure-stage">
      <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-labelledby={`${id}-title ${id}-status`} data-steps-svg set:html={stepsSvg(reading)} />
      <p class="plane-figure-hint">
        Chaque point vert est une position m a + n b pour m et n entiers entre −{COEFFICIENT_MAX} et {COEFFICIENT_MAX} ; l’anneau marque la position courante. La plage de calcul est finie : les points affichés ne sont pas nécessairement toutes les positions accessibles.
      </p>
    </div>
    <div class="plane-figure-side">
      <div class="plane-controls" role="group" aria-label="Pas et coefficients">
        {FIELDS.map(name => (
          <label class="plane-field">
            <span>{labels[name]}</span>
            <input type="number" inputmode="numeric" step="1" min={LIMITS[name][0]} max={LIMITS[name][1]} value={state[name]} data-param={name} disabled />
          </label>
        ))}
      </div>
      <div class="plane-actions">
        {coefficientActions.map(([action, label]) => (
          <button type="button" class="button secondary" data-action={action} disabled>{label}</button>
        ))}
        <button type="button" class="button primary" data-action="reset" disabled>Remettre les coefficients à zéro</button>
      </div>
      <dl class="plane-reading" data-steps-rows>
        {text.rows.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
      </dl>
      <p class="plane-status" id={`${id}-status`} role="status" aria-live="polite" data-steps-status>{text.status}</p>
    </div>
  </div>
  <p class="series-table-caption" id={`${id}-table-caption`}>Positions affichées, avec un couple (m, n) qui les atteint (|m| + |n| minimal)</p>
  <div class="table-scroll series-table" tabindex="0" role="region" aria-labelledby={`${id}-table-caption`}>
    <table aria-labelledby={`${id}-table-caption`}>
      <thead><tr><th scope="col">Position</th><th scope="col">Couple (m, n)</th><th scope="col">Calcul</th></tr></thead>
      <tbody data-steps-table>
        {text.table.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
  <p class="technical-note">Les calculs sont exacts (entiers). La figure explore des exemples : elle ne démontre rien et ne remplace pas les démonstrations de la leçon.</p>
  <noscript><p class="technical-note">Activez JavaScript pour modifier la figure. La figure, ses valeurs initiales et le tableau restent lisibles.</p></noscript>
</figure>
<script>
  import { initStepsFigure } from '../../scripts/steps-figures';
  document.querySelectorAll<HTMLElement>('[data-steps-figure]').forEach(initStepsFigure);
</script>

---
/**
 * Interactive figure of the lesson « Morphismes & isomorphismes »: the map
 * p(k) = r^k from the integers to the rotations of the square, tried on a
 * finite range. The line, the text reading and the table of the 25 integers
 * are rendered at build time; src/scripts/morphism-figures.ts makes the
 * controls live.
 * Usage in MDX: <MorphismFigure number="1" />
 */
import { FIELDS, MORPHISM_PRESET, RANGE, SUM_RANGE, morphismReading, morphismText, type MorphismField } from '../../figures/morphism';
import { morphismSvg, HEIGHT, WIDTH } from '../../figures/morphism-svg';
import '../../styles/figures.css';
import '../../styles/figures-morphism.css';

interface Props { number?: string }
const { number } = Astro.props;
const id = 'figure-morphisme';
const state = { ...MORPHISM_PRESET };
const reading = morphismReading(state);
const text = morphismText(reading);
const labels: Record<MorphismField, string> = { m: 'Entier m', n: 'Entier n' };
const actions: [string, string][] = [['m-up', 'm + 1'], ['m-down', 'm − 1'], ['n-up', 'n + 1'], ['n-down', 'n − 1']];
---
<figure class="plane-figure series-figure morphism-figure" id={id} data-morphism-figure aria-labelledby={`${id}-title`}>
  <figcaption class="plane-figure-caption">
    <span class="eyebrow">Figure{number && ` ${number}`} · interactive</span>
    <span class="plane-figure-title" id={`${id}-title`}>Des entiers aux rotations du carré</span>
  </figcaption>
  <div class="plane-figure-layout">
    <div class="plane-figure-stage">
      <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-labelledby={`${id}-title ${id}-status`} data-morphism-svg set:html={morphismSvg(reading)} />
      <p class="plane-figure-hint">
        Chaque point est un entier k de −12 à 12, nommé par la rotation p(k) = r^k : e, r, r², r³. L’anneau plein marque m, l’anneau pointillé marque n. Expérience finie : m et n entre −12 et 12, somme m + n calculée exactement entre −24 et 24 ; ces essais ne prouvent pas la propriété générale.
      </p>
    </div>
    <div class="plane-figure-side">
      <div class="plane-controls" role="group" aria-label="Entiers m et n">
        {FIELDS.map(name => (
          <label class="plane-field">
            <span>{labels[name]}</span>
            <input type="number" inputmode="numeric" step="1" min={RANGE[0]} max={RANGE[1]} value={state[name]} data-param={name} disabled />
          </label>
        ))}
      </div>
      <div class="plane-actions">
        {actions.map(([action, label]) => (
          <button type="button" class="button secondary" data-action={action} disabled>{label}</button>
        ))}
        <button type="button" class="button primary" data-action="reset" disabled>Revenir à m = 1 et n = 5</button>
      </div>
      <dl class="plane-reading" data-morphism-rows>
        {text.rows.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
      </dl>
      <p class="plane-status" id={`${id}-status`} role="status" aria-live="polite" data-morphism-status>{text.status}</p>
    </div>
  </div>
  <p class="series-table-caption" id={`${id}-table-caption`}>Les {RANGE[1] - RANGE[0] + 1} entiers de {`−${-RANGE[0]}`} à {RANGE[1]} et leur rotation p(k) = r^k</p>
  <div class="table-scroll series-table" tabindex="0" role="region" aria-labelledby={`${id}-table-caption`}>
    <table aria-labelledby={`${id}-table-caption`}>
      <thead><tr><th scope="col">Entier k</th><th scope="col">Division euclidienne par 4</th><th scope="col">Rotation p(k)</th></tr></thead>
      <tbody data-morphism-table>
        {text.table.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
  <p class="technical-note">Les calculs sont exacts (entiers), sur une plage finie : somme calculée entre −{-SUM_RANGE[0]} et {SUM_RANGE[1]}. La figure explore des exemples : elle ne démontre rien et ne remplace pas les démonstrations de la leçon.</p>
  <noscript><p class="technical-note">Activez JavaScript pour modifier la figure. La figure, ses valeurs initiales et le tableau restent lisibles.</p></noscript>
</figure>
<script>
  import { initMorphismFigure } from '../../scripts/morphism-figures';
  document.querySelectorAll<HTMLElement>('[data-morphism-figure]').forEach(initMorphismFigure);
</script>

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import LessonCard from '../components/LessonCard.astro';
import { lessons } from '../data/catalog';
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="small-rule"></span> Mathématiques · Exploration · Abstraction</p><h1>Les idées<br />prennent <em>forme.</em></h1><p class="hero-description">Un atelier pour manipuler, explorer et prendre le temps de comprendre les mathématiques.</p><div class="hero-actions"><a class="button primary" href="/cours/groupes-rotations/">Entrer dans l’atelier <Icon name="arrow" /></a><a class="text-link" href="/atlas/">Explorer l’Atlas <span aria-hidden="true">↗</span></a></div><p class="hero-note"><span class="status-dot"></span> Première exploration : groupes & rotations du carré</p></div>
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-index">FIG. 01 <span>ÉTUDE DE ROTATION</span></div>
      <svg viewBox="0 0 520 470" class="hero-square"><defs><pattern id="hero-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#33594b" opacity=".25" /></pattern></defs><rect width="520" height="470" fill="url(#hero-dots)" /><circle cx="260" cy="230" r="165" stroke="#33594b" stroke-opacity=".12" /><circle cx="260" cy="230" r="118" stroke="#33594b" stroke-opacity=".15" stroke-dasharray="3 6" /><path d="M260 30v400M60 230h400" stroke="#33594b" stroke-opacity=".12" /><rect x="171" y="141" width="178" height="178" fill="none" stroke="#33594b" stroke-opacity=".25" stroke-dasharray="5 6" /><g transform="rotate(-28 260 230)"><rect x="171" y="141" width="178" height="178" fill="#3d6252" fill-opacity=".075" stroke="#33594b" stroke-width="2" /><path d="m171 141 178 178m0-178L171 319" stroke="#33594b" stroke-opacity=".18" /><circle cx="171" cy="141" r="6" fill="#a65b36" /><circle cx="349" cy="141" r="5" fill="#33594b" /><circle cx="171" cy="319" r="5" fill="#33594b" /><circle cx="349" cy="319" r="5" fill="#33594b" /></g><circle cx="260" cy="230" r="4" fill="#33594b" /><path d="M417 179a165 165 0 0 0-75-91m0 0 5 13m-5-13 14-1" stroke="#a65b36" stroke-width="1.5" /><text x="130" y="173" fill="#33594b" font-size="14" font-family="Georgia">A</text><text x="300" y="97" fill="#33594b" font-size="14" font-family="Georgia">B</text><text x="388" y="290" fill="#33594b" font-size="14" font-family="Georgia">C</text><text x="215" y="368" fill="#33594b" font-size="14" font-family="Georgia">D</text></svg>
      <div class="visual-caption"><span class="caption-line"></span><span>Un carré. Un mouvement.<br /><strong>Un point de départ.</strong></span><span class="visual-symbol">↻</span></div>
    </div>
  </section>
  <div class="principles-bar wrap"><span><span class="tiny-index">01</span> Manipuler librement</span><span><span class="tiny-index">02</span> Avancer à son rythme</span><span><span class="tiny-index">03</span> Accéder aux preuves</span></div>
  <section class="section wrap" aria-labelledby="explorations-title"><div class="section-heading"><div><p class="eyebrow">La bibliothèque</p><h2 id="explorations-title">Une première porte d’entrée.</h2></div><a class="text-link" href="/bibliotheque/">Tous les cours <Icon name="arrow" size={18} /></a></div><div class="lesson-grid">{lessons.map(lesson => <LessonCard lesson={lesson} />)}</div></section>
  <section class="atlas-teaser wrap"><div class="teaser-copy"><p class="eyebrow">Une autre façon de naviguer</p><h2>Votre prochaine idée<br />se trouve peut-être<br /><em>juste à côté.</em></h2><p>Ouvrez l’Atlas, sélectionnez un thème et retrouvez les explorations disponibles.</p><a class="button primary" href="/atlas/">Parcourir l’Atlas <Icon name="arrow" /></a><span class="teaser-note">Carte prototype · liens scientifiques à valider</span></div><div class="atlas-illustration" aria-hidden="true"><svg viewBox="0 0 500 360"><g fill="none" stroke="currentColor" opacity=".2"><ellipse cx="250" cy="180" rx="190" ry="135" transform="rotate(-18 250 180)"/><ellipse cx="250" cy="180" rx="120" ry="165" transform="rotate(40 250 180)"/><path d="m120 120 130-40 140 100-100 110-170-30Z" stroke-dasharray="4 8"/></g><g fill="currentColor"><circle cx="120" cy="120" r="12"/><circle cx="390" cy="180" r="9"/><circle cx="290" cy="290" r="8"/><circle cx="120" cy="260" r="6"/></g><circle cx="250" cy="80" r="15" fill="#d6a578"/><g fill="currentColor" font-size="13" font-family="system-ui"><text x="76" y="96">Groupes</text><text x="264" y="64">Rotations du carré</text><text x="361" y="211">Géométrie</text><text x="300" y="319">Analyse</text><text x="48" y="286">Topologie</text></g></svg><span>Disposition illustrative · aucune relation scientifique représentée</span></div></section>
  <section class="closing-note wrap"><span class="eyebrow">Un projet en construction</span><p>L’expérience se construit.<br /><em>La rigueur reste le point de départ.</em></p><span>Les cours et les démonstrations seront intégrés après validation scientifique.</span></section>
</Layout>

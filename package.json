{
  "name": "atelier-des-abstractions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/vendor-p5.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/vendor-p5.mjs",
    "build": "astro build",
    "verify:build": "node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "npm run test:core && npm run test:dom && npm run test:p5 && npm run test:figures",
    "test:core": "node --experimental-strip-types tests/core.test.mjs",
    "test:dom": "node --experimental-strip-types tests/dom.test.mjs",
    "test:p5": "node --experimental-strip-types tests/p5.test.mjs",
    "test:browser": "npm run build && python3 tests/browser_p5.py && python3 tests/browser_site.py && npm run test:drafts",
    "build:drafts": "ATELIER_DRAFTS=1 astro build --outDir test-results/dist-drafts",
    "test:drafts": "npm run build:drafts && python3 tests/browser_site.py --drafts",
    "test:figures": "node --experimental-strip-types tests/figures.test.mjs && node --experimental-strip-types tests/series.test.mjs && node --experimental-strip-types tests/steps.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "astro": "^7.4.12",
    "katex": "^0.19.1",
    "p5": "2.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "^0.187.0",
    "jsdom": "^24.1.3",
    "typescript": "^6.0.3"
  }
}

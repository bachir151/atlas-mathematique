{
  "name": "atelier-des-abstractions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "verify:build": "node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "npm run test:core && npm run test:dom",
    "test:core": "node --experimental-strip-types tests/core.test.mjs",
    "test:dom": "node --experimental-strip-types tests/dom.test.mjs",
    "audit:claude": "python3 scripts/audit_claude.py"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "astro": "^5.16.0",
    "katex": "^0.16.22",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/katex": "^0.16.7",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "jsdom": "^24.1.3"
  }
}
